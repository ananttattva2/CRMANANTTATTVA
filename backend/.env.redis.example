# Append to the existing backend .env; do not replace MongoDB/auth settings.
# Optional: existing memory caching remains active while disabled.
REDIS_CACHE_ENABLED=false
REDIS_URL=
# Use a unique prefix for each app/environment sharing the same cache.
REDIS_CACHE_PREFIX=crm:production:read-cache:v1
# DigitalOcean Valkey: use rediss:// and the provided CA certificate.
REDIS_CA_PATH=
