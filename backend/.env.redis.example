# Copy these settings into backend/.env on the server. Never commit credentials.
# Local Redis on the same Droplet (hex password needs no URL encoding):
REDIS_URL=redis://default:REPLACE_WITH_HEX_PASSWORD@127.0.0.1:6379/0
REDIS_CACHE_ENABLED=true
REDIS_CACHE_PREFIX=crm:production:v1
REDIS_CACHE_TTL_SECONDS=60
REDIS_CACHE_TIMEOUT_MS=200

# DigitalOcean Managed Valkey alternative: copy its private TLS connection URL.
# REDIS_URL=rediss://default:URL_ENCODED_PASSWORD@PRIVATE_HOST:25061/0
# Keep TLS certificate validation enabled; never set rejectUnauthorized=false.
