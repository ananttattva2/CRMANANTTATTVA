# Merge into backend host environment. Never commit populated secrets.
SPACES_BUCKET=ananttattva-crm-files
SPACES_REGION=sgp1
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Generate once with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable on every instance and across deployments.
SPACES_LINK_SECRET=
STORAGE_PUBLIC_API_ORIGIN=https://crmananttattva.com
SPACES_UPLOAD_MAX_MB=25

# Required for library discovery/original downloads. Migration never deletes Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_PREFIX=https://api.cloudinary.com

# Use existing MONGO_ATLAS_URI or MONGO_URI and DB_NAME from the CRM backend.
# Empty means all non-system, non-view collections in the configured CRM database.
STORAGE_MIGRATION_COLLECTIONS=
